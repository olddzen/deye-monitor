# --- Інвертор (Wi-Fi стік Solarman/Deye) ---
# local | simulate (фейковий інвертор для перевірки бота)
DEYE_MODE=local
# IP стіка в домашній мережі (подивись у роутері)
DEYE_LOGGER_IP=192.168.1.50
# серійник стіка (10 цифр, на наклейці стіка, НЕ інвертора)
DEYE_LOGGER_SERIAL=0000000000
DEYE_LOGGER_PORT=8899
DEYE_SLAVE_ID=1

# --- Telegram ---
# від @BotFather
TELEGRAM_BOT_TOKEN=
# бот підкаже його у відповідь на /start
TELEGRAM_CHAT_ID=

# --- Логіка ---
# секунд між опитуваннями
POLL_INTERVAL=30
# нижче цієї напруги вважаємо, що світла немає
GRID_VOLTAGE_MIN=180
# скільки опитувань поспіль для підтвердження зміни
DEBOUNCE_READINGS=2
# пороги заряду батареї під час відключення, %
SOC_ALERTS=30,15
# через скільки секунд без зв'язку з інвертором слати алерт
UNREACHABLE_ALERT_AFTER=600
SAMPLE_EVERY=300
KEEP_SAMPLES_DAYS=90
DB_PATH=data/deye.sqlite3
TZ_NAME=Europe/Kyiv
