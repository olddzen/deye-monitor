# --- Інвертор (Wi-Fi стік Solarman/Deye) ---
# local (стік у тій самій мережі) | cloud (Deye Cloud API, нічого вдома не треба) | simulate (тест бота)
DEYE_MODE=local
# IP стіка в домашній мережі (подивись у роутері)
DEYE_LOGGER_IP=192.168.1.50
# серійник стіка (10 цифр, на наклейці стіка, НЕ інвертора)
DEYE_LOGGER_SERIAL=0000000000
DEYE_LOGGER_PORT=8899
DEYE_SLAVE_ID=1

# --- Deye Cloud (тільки для DEYE_MODE=cloud) ---
# AppID і AppSecret: developer.deyecloud.com → створи застосунок
DEYE_CLOUD_APP_ID=
DEYE_CLOUD_APP_SECRET=
# логін і пароль від застосунку Deye Cloud (пароль хешується SHA-256 перед відправкою)
DEYE_CLOUD_EMAIL=
DEYE_CLOUD_PASSWORD=
# або замість пароля одразу його SHA-256 (python -c "import hashlib;print(hashlib.sha256(b'pass').hexdigest())")
DEYE_CLOUD_PASSWORD_SHA256=
DEYE_CLOUD_URL=https://eu1-developer.deyecloud.com
# необов'язково: визначаються автоматично (див. python -m deye_monitor cloud-check)
DEYE_CLOUD_STATION_ID=
DEYE_CLOUD_DEVICE_SN=
DEYE_CLOUD_GRID_VOLTAGE_KEY=
# якщо хмара не оновлювалась стільки секунд — вважаємо, що зв'язку немає
DEYE_CLOUD_STALE_AFTER=1200
# аварії з хмари: 0 Notice, 1 Warning, 2 Failure — надсилати від цього рівня
ALERT_MIN_LEVEL=2

# --- Telegram ---
# від @BotFather
TELEGRAM_BOT_TOKEN=
# бот підкаже його у відповідь на /start
TELEGRAM_CHAT_ID=

# --- Логіка ---
# секунд між опитуваннями (порожньо = 30 для local, 120 для cloud)
POLL_INTERVAL=
# нижче цієї напруги вважаємо, що світла немає
GRID_VOLTAGE_MIN=180
# скільки опитувань поспіль для підтвердження зміни (порожньо = 2 local, 1 cloud)
DEBOUNCE_READINGS=
# пороги заряду батареї під час відключення, %
SOC_ALERTS=30,15
# через скільки секунд без зв'язку з інвертором слати алерт
UNREACHABLE_ALERT_AFTER=
SAMPLE_EVERY=300
KEEP_SAMPLES_DAYS=90
DB_PATH=data/deye.sqlite3
TZ_NAME=Europe/Kyiv
