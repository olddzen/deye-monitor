# --- Інвертор (Wi-Fi стік Solarman/Deye) ---
DEYE_MODE=local                 # local | simulate (фейковий інвертор для перевірки бота)
DEYE_LOGGER_IP=192.168.1.50     # IP стіка в домашній мережі (подивись у роутері)
DEYE_LOGGER_SERIAL=0000000000   # серійник стіка (10 цифр, на наклейці стіка, НЕ інвертора)
DEYE_LOGGER_PORT=8899
DEYE_SLAVE_ID=1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=             # від @BotFather
TELEGRAM_CHAT_ID=               # бот підкаже його у відповідь на /start

# --- Логіка ---
POLL_INTERVAL=30                # секунд між опитуваннями
GRID_VOLTAGE_MIN=180            # нижче цієї напруги вважаємо, що світла немає
DEBOUNCE_READINGS=2             # скільки опитувань поспіль для підтвердження зміни
SOC_ALERTS=30,15                # пороги заряду батареї під час відключення, %
UNREACHABLE_ALERT_AFTER=600     # через скільки секунд без зв'язку з інвертором слати алерт
SAMPLE_EVERY=300
KEEP_SAMPLES_DAYS=90
DB_PATH=data/deye.sqlite3
TZ_NAME=Europe/Kyiv
