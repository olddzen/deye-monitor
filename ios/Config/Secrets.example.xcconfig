// Copy to Secrets.xcconfig (gitignored) and fill in. `$()` keeps "//" from starting a comment.
DEYE_API_BASE = https:/$()/<your-worker>.workers.dev
DEYE_APP_TOKEN = <same value as the worker's APP_TOKEN secret>

// Optional: your Apple team ID for device builds (Xcode → Signing shows it)
// DEVELOPMENT_TEAM = ABCDE12345
